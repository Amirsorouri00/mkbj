<?xml version="1.0" encoding="utf-8"?>

<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The private Artifactory feed below is unreachable without credentials (HTTP 403) and every
      package this solution uses is published on nuget.org. Re-enable it (and remove the
      disabledPackageSources entry) once credentials are configured.
    -->
    <add key="eways-repo" value="https://repository.eways.co/artifactory/api/nuget/v3/nuget/index.json" protocolVersion="3" />
  </packageSources>

  <disabledPackageSources>
    <add key="eways-repo" value="true" />
  </disabledPackageSources>

</configuration>
