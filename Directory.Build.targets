<Project>

  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!--
    Test-project-only settings belong HERE, not in Directory.Build.props. MSBuild imports
    .props BEFORE the project body, so `$(IsTestProject)` is still empty there and a
    PropertyGroup conditioned on it silently never applies. .targets is imported after.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!--
      CA1707: test method names use underscores on purpose — they are sentences.

      xUnit1051: xUnit.net v3's analyzer wants every call accepting an optional
      CancellationToken to be handed TestContext.Current.CancellationToken, so that the runner
      can cancel a hung test. It fires 432 times here, almost entirely at call sites that
      simply omit the optional parameter (`await saga.ExecuteAsync()`).

      Suppressed rather than swept, for two reasons. It is an advisory about runner
      responsiveness, not correctness — the whole suite finishes in under a minute and no test
      has ever hung. More importantly, the saga tests exist specifically to pin WHICH token
      reaches WHICH code path (the D5 graceful-shutdown fix, docs/adr/0010); mechanically
      injecting an ambient token into 432 call sites would blur the one thing they assert.

      The honest cost: if a test ever does hang, the runner cannot cancel it and the run waits.
      Re-enable per file (`#pragma warning restore xUnit1051`) if that ever happens.
    -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
  </PropertyGroup>

</Project>
