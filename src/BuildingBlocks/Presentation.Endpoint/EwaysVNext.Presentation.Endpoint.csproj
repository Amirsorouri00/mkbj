<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EwaysVNext.Presentation.Endpoint</RootNamespace>
    <Description>Endpoint-per-class discovery (IEndpoint), EndpointResult (shapes EwaysVNext.Outcomes.Result/Result&lt;T&gt; into HTTP responses), enum-value endpoint filter, outgoing HTTP logging handler, generic GraphQL server bootstrap.</Description>
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Outcomes\EwaysVNext.Outcomes.csproj" />
    <ProjectReference Include="..\Domain\EwaysVNext.Domain.csproj" />
  </ItemGroup>
</Project>
