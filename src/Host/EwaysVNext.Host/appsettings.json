{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "EwaysVNext",
    "Audience": "EwaysVNext.Clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Host": {
    "AllowedCorsOrigins": []
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Keycloak": {
    "InternalUrl": "http://localhost:8081",
    "ExternalUrl": "http://localhost:8081",
    "Realms": {
      "Shop": {
        "Realm": "Shop",
        "ClientId": "modular-monolith"
      },
      "Backoffice": {
        "Realm": "Backoffice",
        "ClientId": "backoffice-console"
      }
    }
  },
  "Fx": {
    "RefreshInterval": "06:00:00",
    "Ecb": {
      "BaseUrl": "https://www.ecb.europa.eu/stats/eurofxref/"
    }
  }
}
