meta {
  name: Get order
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/orders/:id
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{partnerKey}}
}

docs {
  Your own orders only. Another partner's order is 404, not 403 — 403 would confirm it exists.

  Accepts `ext:<externalOrderId>` in place of the numeric id, so you can look an order up by
  your own reference without storing ours.
}
