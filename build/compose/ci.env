# Placeholders so `docker compose config` can validate the production stack in CI.
# Never used to run anything.
# Copy to .env and fill in. Every value here is a secret or an environment-specific host, which is
# why the template ships empty: a default would eventually be deployed.
# Compose refuses to start when one is missing (${VAR:?}), rather than defaulting quietly.

# Hostnames Caddy serves and requests certificates for.
PUBLIC_HOST=ci-placeholder
AUTH_HOST=ci-placeholder
STORAGE_HOST=ci-placeholder
ACME_EMAIL=ci-placeholder

# PostgreSQL. eways_app owns nothing; eways_migrator owns the schema (ADR-0017 D6).
POSTGRES_PASSWORD=ci-placeholder
APP_DB_PASSWORD=ci-placeholder
MIGRATOR_DB_PASSWORD=ci-placeholder

# MinIO. The root account creates buckets; the application gets its own narrower user.
MINIO_ROOT_USER=ci-placeholder
MINIO_ROOT_PASSWORD=ci-placeholder
MINIO_APP_ACCESS_KEY=ci-placeholder
MINIO_APP_SECRET_KEY=ci-placeholder

# Keycloak.
KC_DB_PASSWORD=ci-placeholder
KC_BOOTSTRAP_ADMIN_USERNAME=ci-placeholder
KC_BOOTSTRAP_ADMIN_PASSWORD=ci-placeholder
KC_SMTP_HOST=ci-placeholder
KC_SMTP_PORT=587
KC_SMTP_FROM=ci-placeholder
KC_SMTP_USER=ci-placeholder
KC_SMTP_PASSWORD=ci-placeholder
KC_SMTP_FROM_DISPLAY_NAME=ci-placeholder
KC_SMTP_STARTTLS=false
KC_SHOP_WEB_ORIGIN=http://localhost:3000
KC_ADMIN_WEB_ORIGIN=http://localhost:5173
KC_API_PUBLIC_URL=http://localhost:8080
SHOP_REDIRECT_URI=ci-placeholder
BACKOFFICE_REDIRECT_URI=ci-placeholder

# Application secrets. The pepper is mixed into every partner API key hash: changing it
# invalidates every issued key.
API_KEYS_PEPPER=ci-placeholder
BRAVE_API_KEY=ci-placeholder
ANTHROPIC_API_KEY=ci-placeholder
