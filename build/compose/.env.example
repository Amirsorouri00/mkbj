# Copy to .env and fill in. Every value here is a secret or an environment-specific host, which is
# why the template ships empty: a default would eventually be deployed.
# Compose refuses to start when one is missing (${VAR:?}), rather than defaulting quietly.

# Hostnames Caddy serves and requests certificates for.
PUBLIC_HOST=
ADMIN_HOST=
SHOP_HOST=
AUTH_HOST=
STORAGE_HOST=
ACME_EMAIL=
# Production is the compose default. The demo bootstrap writes Staging so the demo-only seed is
# allowed without weakening the application's Production guard.
APP_ENVIRONMENT=

# Images built by GitHub Actions. Local builds may leave these blank and use the defaults.
MKBJ_API_IMAGE=
MKBJ_ADMIN_IMAGE=
MKBJ_SHOP_IMAGE=

# PostgreSQL. mkbj_app owns nothing; mkbj_migrator owns the schema (ADR-0017 D6).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=

# MinIO. The root account creates buckets; the application gets its own narrower user.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

# Keycloak.
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_SMTP_HOST=
KC_SMTP_PORT=
KC_SMTP_FROM=
KC_SMTP_USER=
KC_SMTP_PASSWORD=
KC_SMTP_FROM_DISPLAY_NAME=
KC_SMTP_STARTTLS=
KC_SMTP_AUTH=
KC_SHOP_WEB_ORIGIN=
KC_ADMIN_WEB_ORIGIN=
KC_API_PUBLIC_URL=
SHOP_REDIRECT_URI=
BACKOFFICE_REDIRECT_URI=

# Imported only when the realms are first created. Realm import is skipped thereafter, so normal
# deploys never reset these passwords. Keep the same secret values when rebuilding a clean demo.
MKBJ_DEMO_ADMIN_USERNAME=
MKBJ_DEMO_ADMIN_EMAIL=
MKBJ_DEMO_ADMIN_PASSWORD=
MKBJ_DEMO_SHOP_USERNAME=
MKBJ_DEMO_SHOP_EMAIL=
MKBJ_DEMO_SHOP_PASSWORD=

# Application secrets. The pepper is mixed into every partner API key hash: changing it
# invalidates every issued key.
API_KEYS_PEPPER=
BRAVE_API_KEY=
ANTHROPIC_API_KEY=
