# PUBLIC_SCHEME is http for the zero-dependency demo and https when public ACME validation is
# available. An explicit http:// site address keeps Caddy from redirecting to unavailable TLS.
{$PUBLIC_SCHEME}://{$PUBLIC_HOST} {
	encode zstd gzip

	# Product images are served straight from the bucket, so image traffic never occupies an
	# application thread. handle_path strips /media before the rewrite adds the bucket name.
	handle_path /media/* {
		rewrite * /catalog-media{uri}
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy api:8080
	}
}

{$PUBLIC_SCHEME}://{$SHOP_HOST} {
	encode zstd gzip
	reverse_proxy shop-web:3000
}

{$PUBLIC_SCHEME}://{$ADMIN_HOST} {
	encode zstd gzip
	reverse_proxy admin-web:8080
}

{$PUBLIC_SCHEME}://{$AUTH_HOST} {
	reverse_proxy keycloak:8080
}

# The storage host exists so presigned URLs resolve for a browser; the bucket policies, not Caddy,
# decide what may be read anonymously.
{$PUBLIC_SCHEME}://{$STORAGE_HOST} {
	reverse_proxy minio:9000
}
